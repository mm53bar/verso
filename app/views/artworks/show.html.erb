<% content_for :title, @artwork.display_title %>

<p class="mb-6 text-sm"><%= link_to "← Collection", artworks_path, class: "text-neutral-500 hover:underline" %></p>

<article class="grid gap-8 lg:grid-cols-[3fr_2fr]">
  <div>
    <% if @artwork.original.attached? %>
      <%= image_tag @artwork.detail, class: "w-full rounded" %>
    <% end %>
  </div>

  <div>
    <h1 class="text-2xl font-semibold tracking-tight"><%= @artwork.display_title %></h1>
    <p class="mt-1 text-neutral-600">
      <%= @artwork.artist&.name || "Artist unknown" %><%= " · #{@artwork.year_text}" if @artwork.year_text.present? %>
    </p>

    <%# Applied to the leader, so the followers are told and both rooms land on
        the same picture. Offered for anything, including artworks the rotation
        would never choose: the aspect rule exists to stop the rotation picking
        badly, not to overrule someone looking at the picture and asking for it. %>
    <% if (leader = Display.leader) %>
      <div class="mt-4 flex items-center gap-3">
        <% if leader.current_artwork_id == @artwork.id %>
          <span class="rounded border border-neutral-900 bg-neutral-900 px-3 py-1.5 text-sm text-white">
            On the screens now
          </span>
        <% else %>
          <%= button_to "Show this on the screens",
              show_artwork_on_display_path(leader.slug, @artwork.slug),
              class: "rounded border border-neutral-900 px-3 py-1.5 text-sm hover:bg-neutral-50" %>
        <% end %>

        <%# A star means it comes up twice as often. Nothing else. %>
        <%= button_to favourite_artwork_path(@artwork.slug),
            title: @artwork.favourite? ? "Starred: comes up twice as often" : "Star this",
            class: "rounded border px-3 py-1.5 text-sm #{@artwork.favourite? ?
              'border-amber-700 text-amber-700' : 'border-neutral-300 hover:bg-neutral-50'}" do %>
          <%= @artwork.favourite? ? "★ Starred" : "☆ Star" %>
        <% end %>
      </div>
    <% end %>

    <% if @artwork.blurb.present? %>
      <p class="mt-4 text-sm leading-relaxed"><%= @artwork.blurb %></p>
    <% end %>
    <% if @artwork.story.present? %>
      <div class="mt-4 space-y-3 text-sm leading-relaxed"><%= simple_format @artwork.story %></div>
      <%# Two different things, and conflating them states a falsehood about the
          licence. Wikipedia prose is quoted verbatim and is CC BY-SA, so it must
          say so. A story written here from a gallery's page is a citation, not a
          licensed excerpt, and claiming CC BY-SA over someone else's research
          would be wrong. %>
      <% if @artwork.story_source_url.present? %>
        <p class="mt-2 text-xs text-neutral-500">
          <% if @artwork.story_source_name == "Wikipedia" %>
            Story from
            <%= link_to "Wikipedia", @artwork.story_source_url, class: "underline" %>,
            <a href="https://creativecommons.org/licenses/by-sa/4.0/" class="underline">CC BY-SA</a>.
          <% else %>
            Written for verso. Source:
            <%= link_to @artwork.story_source_name.presence || "link",
                @artwork.story_source_url, class: "underline" %>.
          <% end %>
        </p>
      <% end %>
    <% end %>

    <dl class="mt-6 space-y-2 border-t pt-4 text-sm">
      <% {
           "Collection" => @artwork.collection.name,
           "Medium" => @artwork.medium,
           "Where it hangs" => @artwork.current_location,
           "Dimensions" => (@artwork.width ? "#{@artwork.width} × #{@artwork.height}" : nil),
           "Aspect" => @artwork.aspect_ratio&.to_f&.round(2),
           "Licence" => @artwork.license,
           "Credit" => @artwork.credit_line,
           "Weight" => @artwork.weight
         }.each do |label, value| %>
        <% next if value.blank? %>
        <div class="flex gap-3">
          <dt class="w-36 shrink-0 text-neutral-500"><%= label %></dt>
          <dd class="min-w-0 break-words"><%= value %></dd>
        </div>
      <% end %>
    </dl>

    <p class="mt-4 text-sm">
      <% if @displays.any? %>
        Shows on <%= safe_join(@displays.map { |d| link_to d.name, display_path(d), class: "underline" }, ", ") %>.
      <% else %>
        <span class="text-amber-700">Not eligible for any screen — too small, the wrong shape, or unreviewed.</span>
      <% end %>
    </p>

    <% if @artwork.source_url.present? %>
      <p class="mt-2 text-sm"><%= link_to "Source", @artwork.source_url, class: "text-neutral-500 underline" %></p>
    <% end %>
  </div>
</article>
