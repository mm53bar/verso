# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# This machine sets BUNDLE_PATH globally, so gems install into the app.
/vendor/bundle/

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# This repo is public: never commit the credentials file — a committed
# secret_key_base would be shared by every clone. Secrets come from env vars
# (docs/adr/20260816-secrets-from-env.md); bring your own credentials.yml.enc
# only if you deliberately want that escape hatch instead.
/config/credentials.yml.enc


/app/assets/builds/*
!/app/assets/builds/.keep
